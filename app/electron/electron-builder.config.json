{
  "appId": "net.wearedogs.ai",
  "productName": "DOGS AI",
  "directories": {
    "buildResources": "resources",
    "output": "dist"
  },
  "files": ["assets/**/*", "build/**/*", "capacitor.config.*", "app/**/*"],
  "publish": null,
  "win": {
    "target": ["nsis", "portable"],
    "icon": "assets/appIcon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DOGS AI",
    "artifactName": "DOGS-AI-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "DOGS-AI-${version}-portable.${ext}"
  },
  "mac": {
    "category": "public.app-category.graphics-design",
    "target": ["dmg", "zip"],
    "icon": "assets/appIcon.png"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "assets/appIcon.png",
    "category": "Graphics"
  }
}
