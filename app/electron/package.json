{
  "name": "dogs-ai-desktop",
  "productName": "DOGS AI",
  "version": "0.1.0",
  "description": "DOGS AI desktop app: local image, video and audio generation.",
  "author": "DOGS",
  "license": "UNLICENSED",
  "private": true,
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc && node write-home.cjs",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "npm run build && electron ./",
    "electron:pack": "npm run build && electron-builder build --dir -c ./electron-builder.config.json",
    "electron:make": "npm run build && electron-builder build -c ./electron-builder.config.json --publish never"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "chokidar": "~3.5.3",
    "electron-is-dev": "~2.0.0",
    "electron-serve": "~1.1.0",
    "electron-unhandled": "~4.0.1",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "capacitor",
    "electron"
  ],
  "allowScripts": {
    "electron@45.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}
